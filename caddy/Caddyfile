# Prime Agent Hub - Caddy reverse proxy (HTTPS otomatis + proteksi akses)
# Domain utama: primeagent.farraha.com
# Rate limit per IP (plugin mholt/caddy-ratelimit) — Aaron 13 Agu 2026

primeagent.farraha.com {
    encode gzip

    # Proteksi lapis ekstra: blokir request tanpa User-Agent browser umum (anti-bot ringan)
    @blocked not header User-Agent *Mozilla*
    respond @blocked 403

    # Rate limit per IP: 30 request / 10 detik per client (anti-bruteforce & abuse)
    rate_limit {
        zone dynamic {
            key {remote_host}
            events 30
            window 10s
        }
    }

    reverse_proxy prime-agent:3000
}

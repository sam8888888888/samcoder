# Prime Agent Hub - Caddy reverse proxy (HTTPS otomatis + proteksi akses)
# Domain utama: coder.sam.university
# primeagent.farraha.com DIMATIKAN TOTAL 19 Agu 2026 (keputusan Papi) - DNS NXDOMAIN di Cloudflare
# Whitelist IP Papi (182.8.65.3) — bypass anti-bot & rate limit
# Rate limit per IP (plugin mholt/caddy-ratelimit)

coder.sam.university {
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    @blocked {
        not header User-Agent *Mozilla*
        not path /api/telegram/webhook
        not path /api/whatsapp/webhook
        not remote_ip 182.8.65.3
    }
    respond @blocked 403

    rate_limit {
        zone dynamic {
            key {remote_host}
            events 30
            window 10s
            except 182.8.65.3
        }
    }

    reverse_proxy prime-agent:3000
}

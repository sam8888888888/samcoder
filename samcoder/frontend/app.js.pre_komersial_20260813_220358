    // File tree: kelompokkan file yang ada di subfolder
    const tree = {}; // folderPath -> {name, files:[], folders:{}}
    filesCache.forEach(f => {
      const parts = f.path.split('/');
      let node = tree;
      for (let i = 0; i < parts.length - 1; i++) {

let busy = false;
let authed = false;
let me = null;
let primeHasAvatar = false;
let currentArtifact = null;
let filesCache = [];
let sessionsCache = [];
let modelsCache = [];
let pendingImages = [];
let pendingFiles = []; // [{path, name, desc, mime, size}]

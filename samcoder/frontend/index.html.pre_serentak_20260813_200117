<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content">
<meta name="theme-color" content="#0f1117">
<title>Prime Agent Hub</title>
<link rel="manifest" href="/manifest.json">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.5/purify.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<link rel="stylesheet" href="/styles.css">
</head>
<body>

<div id="app">
  <!-- Sidebar -->
  <aside id="sidebar">
    <div class="side-head">
      <button class="icon-btn" id="sidebar-toggle" title="Sembunyikan sidebar">☰</button>
      <img class="logo-badge" src="/icon-192.png" alt="Prime Agent Hub">
      <div class="side-title">Prime Agent Hub</div>
    </div>
    <button id="new-chat-btn">✏️ Chat Baru</button>
    <input type="text" id="session-search" placeholder="🔍 Cari sesi..." style="display:none;margin:8px 12px;width:calc(100% - 24px);padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);font-size:13px;">
    <div id="session-list"><div class="art-empty">Belum ada sesi.<br>Klik "Chat Baru" untuk mulai.</div></div>
    <div class="side-foot">
      <button class="side-foot-item" id="settings-open">
        <span class="f-ico">⚙️</span><span class="f-name">Pengaturan</span>
      </button>
      <button class="side-foot-item" id="theme-toggle">
        <span class="f-ico">🌙</span><span class="f-name">Tema</span><span class="f-badge" id="theme-label">Gelap</span>
      </button>
    </div>
    <div class="side-user" id="side-user" style="display:none;">
      <img id="side-avatar" class="user-avatar" src="" alt="">
      <div class="user-meta">
        <div class="user-name" id="side-name">—</div>
        <div class="user-role" id="side-role">—</div>
      </div>
      <button class="icon-btn" id="logout-btn" title="Logout">⎋</button>
    </div>
  </aside>
  <div id="sidebar-overlay"></div>

  <div id="cmd-palette" style="display:none;position:fixed;top:15%;left:50%;transform:translateX(-50%);width:min(420px,90vw);background:var(--bg,#14171f);border:1px solid var(--border,#2a2f3a);border-radius:14px;z-index:999;box-shadow:0 12px 40px rgba(0,0,0,.5);overflow:hidden;">
    <div style="padding:14px 16px;border-bottom:1px solid var(--border,#2a2f3a);font-weight:700;">⚡ Perintah Cepat</div>
    <div style="padding:8px 12px;border-bottom:1px solid var(--border,#2a2f3a);">
      <input type="text" id="cmd-input" placeholder="Ketik perintah... (Chat Baru, Tema, Status, dll)" style="width:100%;padding:10px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);font-size:14px;">
    </div>
    <div id="cmd-list" style="max-height:260px;overflow-y:auto;padding:6px;"></div>
  </div>
  <div id="cmd-backdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:998;"></div>

  <div id="subagents-modal" style="display:none;position:fixed;top:12%;left:50%;transform:translateX(-50%);width:min(520px,92vw);background:var(--bg,#14171f);border:1px solid var(--border,#2a2f3a);border-radius:14px;z-index:999;box-shadow:0 12px 40px rgba(0,0,0,.5);overflow:hidden;">
  <div style="display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid var(--border,#2a2f3a);">
    <div style="flex:1;font-weight:700;">🧩 Peta Subagent</div>
    <button id="subagents-close" class="close-x">×</button>
  </div>
  <div id="subagents-body" style="padding:14px 16px;max-height:60vh;overflow-y:auto;font-size:13px;">Memuat...</div>
</div>
<div id="subagents-backdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:998;"></div>

<!-- Login -->
  <div id="main">
    <div id="topbar">
      <button class="icon-btn home-btn" id="home-btn" title="Kembali ke beranda">🏠</button>
      <button class="icon-btn" id="menu-btn" title="Buka sidebar">☰</button>
      <div class="tb-title" id="tb-title">utama</div>
      <span class="status-pill" id="status-pill"><span class="status-dot"></span><span id="status-text">terhubung</span></span>
      <div class="spacer"></div>
      <button class="icon-btn" id="artifacts-toggle" title="Panel artefak">📁</button>
      <button class="icon-btn" id="subagents-toggle" title="Peta subagent">🧩</button>
    </div>

    <div id="chat"><div class="container" id="messages">
      <div class="msg assistant"><div class="avatar" id="prime-avatar-msg">🤖</div><div class="bubble">Halo Mas! 👋 Aku <b>Prime</b> — siap bantu coding, riset, dan kerja panjang. Ketik perintahmu di bawah. File yang kubuat akan muncul di panel artefak.</div></div>
    </div></div>

    <div id="input-area">
      <div id="image-preview"></div>
      <div class="input-tools">
        <select class="model-select" id="model-select" title="Model aktif (sesi ini)" style="display:none;"><option value="">Memuat model…</option></select>
        <button class="tool-chip" id="plan-toggle" title="Mode Rencana: Prime jelaskan rencana dulu, baru eksekusi setelah kamu ACC">🧠 Rencana</button>
        <span class="tool-hint" id="plan-hint" style="display:none;">Mode Rencana aktif — Prime akan jelaskan rencana dulu.</span>
        <div class="activity-bar" id="activity-bar" style="display:none;"><span class="activity-spin">◌</span> Prime sedang bekerja: <span id="activity-text">…</span></div>
      </div>
      <div class="input-wrap">
        <button id="attach-btn" title="Lampirkan gambar">📷</button>
        <button id="prompt-btn" title="Template prompt">📝</button>
        <button id="upload-btn" title="Upload file (dokumen, kode, dll)">📎</button>
        <input type="file" id="upload-file" style="display:none;" multiple>
        <textarea id="message" rows="2" placeholder="Ketik pesan ke Prime... (Enter kirim, Shift+Enter baris baru)"></textarea>
        <button id="mic-btn" title="Input suara" style="display:none;">🎙️</button>
        <button id="stop-btn" title="Hentikan Prime" style="display:none;">⏹ Stop</button>
        <button id="send">Kirim</button>
      </div>
      <div class="hint">Ditenagai <b>Prime Agent</b> · Akses pribadi · <b>primeagent.farraha.com</b></div>
    </div>
  </div>

  <!-- Artifacts -->
  <div id="artifacts">
    <div class="art-head">📁 Artefak <span class="art-count" id="art-count">0 file</span><button class="icon-btn" id="artifacts-close" title="Sembunyikan panel artefak" style="margin-left:auto;">✕</button></div>
    <div id="artifact-list">
      <div class="art-empty">Belum ada artefak.<br>Minta Prime membuat file,<br>misal: <b>"buatkan landing page HTML"</b></div>
    </div>
  </div>
</div>

<!-- Artifact viewer -->
<div id="artifact-viewer">
  <div class="av-head">
    <div class="av-title" id="av-title">file</div>
    <div class="av-actions">
      <button class="btn small" id="av-copy">⧉ Copy</button>
      <button class="btn small" id="av-preview" style="display:none;">👁 Preview</button>
      <button class="btn small" id="av-download">⬇ Download</button>
      <button class="close-x" id="av-close">×</button>
    </div>
  </div>
  <div class="av-body" id="av-body"></div>
</div>

<!-- Settings -->
<div id="settings">
  <div class="set-head">
    <div class="set-title">⚙️ Pengaturan</div>
    <button class="close-x" id="settings-close">×</button>
  </div>
  <div class="set-body">
    <div class="set-tabs">
      <div class="set-tab active" data-tab="profile">👤 Profil Saya</div>
      <div class="set-tab" data-tab="apikeys">🔑 API Keys</div>
      <div class="set-tab" data-tab="history">💬 Riwayat</div>
      <div class="set-tab" data-tab="security">🔒 Keamanan</div>
      <div class="set-tab" data-tab="users" id="tab-users" style="display:none;">👥 Kelola User</div>
      <div class="set-tab" data-tab="prime">🖼️ Foto Prime</div>
      <div class="set-tab" data-tab="update">🔄 Update</div>
      <div class="set-tab" data-tab="token">⚡ Hemat Token</div>
      <div class="set-tab" data-tab="status">📊 Status</div>
      <div class="set-tab" data-tab="prompts">📝 Template</div>
      <div class="set-tab" data-tab="schedules">⏰ Jadwal</div>
      <div class="set-tab" data-tab="autonomous">🤖 Mode Otonom</div>
      <div class="set-tab" data-tab="skills">🧠 Skills</div>
    </div>

    <div class="set-panel" id="panel-profile">
      <h3>Profil Saya</h3>
      <div class="field">
        <img id="profile-avatar" class="avatar-preview" src="" alt="">
        <input type="file" id="profile-avatar-file" accept="image/png,image/jpeg,image/webp">
      </div>
      <div class="field"><label>Nama Tampilan</label><input type="text" id="profile-name" placeholder="Nama kamu"></div>
      <button class="btn primary" id="profile-save">Simpan Profil</button>
      <div class="msg-ok" id="profile-ok"></div>
      <div class="msg-err" id="profile-err"></div>
    </div>

    <div class="set-panel" id="panel-apikeys" style="display:none;">
      <h3>API Keys</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:14px;">Tambahkan API key milikmu sendiri. Model yang tersedia otomatis muncul di picker atas. Key bawaan: DeepSeek.</p>
      <div id="apikey-list"></div>
      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);">
        <h3 style="margin-bottom:12px;">Tambah API Key</h3>
        <div class="field"><label>Provider</label>
          <select id="ak-provider">
            <option value="deepseek">DeepSeek (api.deepseek.com)</option>
            <option value="openrouter">OpenRouter (paling banyak model)</option>
            <option value="openai">OpenAI</option>
            <option value="anthropic">Anthropic</option>
            <option value="google">Google Gemini</option>
            <option value="groq">Groq</option>
            <option value="mistral">Mistral</option>
            <option value="xai">xAI</option>
          </select>
        </div>
        <div class="field"><label>API Key</label><input type="password" id="ak-key" placeholder="sk-..."></div>
        <button class="btn primary" id="ak-save">Simpan Key</button>
        <div class="msg-ok" id="ak-ok"></div>
        <div class="msg-err" id="ak-err"></div>
      </div>
    </div>

    <div class="set-panel" id="panel-history" style="display:none;">
      <h3>Riwayat</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:14px;">Riwayat obrolan disimpan otomatis selama <b>1 tahun</b>. Kamu bisa menghapusnya kapan saja.</p>
      <button class="btn danger" id="history-clear-all">🗑️ Hapus Semua Riwayat</button>
      <div class="msg-ok" id="history-ok"></div>
    </div>

    <div class="set-panel" id="panel-security" style="display:none;">
      <h3>Ganti Password</h3>
      <div class="field"><label>Password Lama</label><input type="password" id="pw-old" autocomplete="current-password"></div>
      <div class="field"><label>Password Baru (min 8 karakter)</label><input type="password" id="pw-new" autocomplete="new-password"></div>
      <div class="field"><label>Ulangi Password Baru</label><input type="password" id="pw-new2" autocomplete="new-password"></div>
      <button class="btn primary" id="pw-save">Ganti Password</button>
      <div class="msg-ok" id="pw-ok"></div>
      <div class="msg-err" id="pw-err"></div>
      <div style="margin-top:24px;padding-top:16px;border-top:1px solid var(--border);">
        <h3 style="margin-bottom:10px;">🔐 Verifikasi 2 Langkah (MFA)</h3>
        <p style="color:var(--muted);font-size:13px;margin-bottom:12px;">Tambahkan Google Authenticator / Authy / 1Password untuk keamanan ekstra saat login.</p>
        <div id="mfa-status" style="font-size:14px;margin-bottom:10px;">memeriksa...</div>
        <div id="mfa-setup-box" style="display:none;">
          <div class="field"><label>Secret (scan QR atau masukkan manual)</label><div id="mfa-secret" style="font-family:monospace;font-size:13px;word-break:break-all;"></div></div>
          <div id="mfa-qr" style="margin:10px 0;"></div>
          <div class="field"><label>Kode 6 digit dari aplikasi</label><input type="text" id="mfa-code" inputmode="numeric" maxlength="6"></div>
          <button class="btn primary" id="mfa-enable-btn">Aktifkan MFA</button>
        </div>
        <button class="btn" id="mfa-setup-btn" style="display:none;">🔐 Setup MFA</button>
        <button class="btn danger" id="mfa-disable-btn" style="display:none;">Nonaktifkan MFA</button>
        <div class="msg-ok" id="mfa-ok"></div>
        <div class="msg-err" id="mfa-err"></div>
      </div>
    </div>

    <div class="set-panel" id="panel-users" style="display:none;">
      <h3>Kelola User</h3>
      <div id="user-list"></div>
      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);">
        <h3 style="margin-bottom:12px;">Tambah User Baru</h3>
        <div class="field"><label>Username</label><input type="text" id="nu-username" placeholder="misal: farraha"></div>
        <div class="field"><label>Password</label><input type="password" id="nu-password" placeholder="min 8 karakter"></div>
        <div class="field"><label>Nama Tampilan</label><input type="text" id="nu-name" placeholder="misal: Farraha"></div>
        <div class="field"><label>Peran</label>
          <select id="nu-role">
            <option value="member">Member</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <button class="btn primary" id="nu-save">Tambah User</button>
        <div class="msg-ok" id="nu-ok"></div>
        <div class="msg-err" id="nu-err"></div>
      </div>
    </div>

    <div class="set-panel" id="panel-prime" style="display:none;">
      <h3>Foto Prime</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:14px;">Ubah avatar Prime yang tampil di chat (khusus admin).</p>
      <div class="field">
        <img id="prime-avatar-preview" class="avatar-preview" src="" alt="">
        <input type="file" id="prime-avatar-file" accept="image/png,image/jpeg,image/webp">
      </div>
      <button class="btn primary" id="prime-avatar-save">Simpan Foto Prime</button>
      <button class="btn" id="prime-avatar-reset" style="margin-left:8px;">Reset ke Default</button>
      <div class="msg-ok" id="prime-ok"></div>
      <div class="msg-err" id="prime-err"></div>
    </div>

    <div class="set-panel" id="panel-update" style="display:none;">
      <h3>🔄 Update Prime Agent</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:14px;">Cek & perbarui Prime Agent ke versi terbaru. Update mencakup fitur baru & perbaikan keamanan.</p>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
        <div class="field" style="margin-bottom:0;"><label>Versi Terpasang</label><div style="font-size:16px;font-weight:700;" id="ver-local">—</div></div>
        <div class="field" style="margin-bottom:0;"><label>Versi Terbaru</label><div style="font-size:16px;font-weight:700;" id="ver-latest">—</div></div>
        <div class="field" style="margin-bottom:0;"><label>Status</label><div style="font-size:14px;font-weight:600;" id="ver-status">memeriksa...</div></div>
      </div>
      <button class="btn primary" id="update-check">🔍 Cek Update</button>
      <button class="btn gold" id="update-now" style="margin-left:8px;">⬇️ Update Sekarang</button>
      <div id="update-log" style="margin-top:14px;padding:12px;background:var(--bg);border:1px solid var(--border);border-radius:10px;font-family:'JetBrains Mono',Consolas,monospace;font-size:12px;white-space:pre-wrap;max-height:220px;overflow-y:auto;display:none;"></div>
      <div class="msg-ok" id="update-ok"></div>
      <div class="msg-err" id="update-err"></div>
    </div>

    <div class="set-panel" id="panel-token" style="display:none;">
      <h3>⚡ Hemat Token</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:14px;">Kendalikan pemakaian token biar nggak bengkak. Prime default mikir sangat dalam (xhigh) — turunkan levelnya untuk tugas ringan.</p>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap;">
        <div class="field" style="margin-bottom:0;"><label>Model Aktif</label><div style="font-size:15px;font-weight:700;" id="tok-model">—</div></div>
        <div class="field" style="margin-bottom:0;"><label>Pesan di Sesi</label><div style="font-size:15px;font-weight:700;" id="tok-count">—</div></div>
        <div class="field" style="margin-bottom:0;"><label>Auto-Compact</label><div style="font-size:15px;font-weight:700;" id="tok-auto">—</div></div>
      </div>
      <div class="field">
        <label>Level Berpikir (Thinking Level)</label>
        <select id="tok-level">
          <option value="off">Off — hemat maksimal (tanpa reasoning)</option>
          <option value="minimal">Minimal — sangat hemat</option>
          <option value="low">Low — hemat</option>
          <option value="medium" selected>Medium — seimbang (rekomendasi)</option>
          <option value="high">High — dalam</option>
          <option value="xhigh">XHigh — sangat dalam (default, boros)</option>
          <option value="max">Max — maksimal (paling boros)</option>
        </select>
      </div>
      <button class="btn primary" id="tok-save">💾 Simpan Level</button>
      <button class="btn gold" id="tok-compact" style="margin-left:8px;">📦 Ringkas Konteks Sekarang</button>
      <div class="msg-ok" id="tok-ok"></div>
      <div class="msg-err" id="tok-err"></div>
      <div style="margin-top:18px;padding-top:16px;border-top:1px solid var(--border);">
        <h3 style="margin-bottom:10px;">💡 Tips Hemat Token</h3>
        <ul style="margin:0;padding-left:18px;color:var(--muted);font-size:13px;line-height:1.8;">
          <li>Gunakan <b>Medium/Low</b> untuk tugas ringan, <b>High</b> hanya untuk debugging sulit</li>
          <li>Pakai model <b>Flash</b> (murah) untuk tugas sederhana, <b>Pro</b> untuk yang kompleks</li>
          <li>Tekan <b>Ringkas Konteks</b> setelah fase kerja selesai — riwayat lama diringkas</li>
          <li>Buat <b>sesi baru</b> untuk tugas baru — jangan bawa konteks lama</li>
          <li>Minta Prime jawab <b>singkat</b> — jangan panjang-panjang</li>
        </ul>
      </div>
    </div>

    <div class="set-panel" id="panel-status" style="display:none;">
      <h3>📊 Status Hub</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:14px;">Pantau kesehatan hub & sesi kamu secara real-time.</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;">
        <div class="stat-card"><div class="stat-label">Uptime Hub</div><div class="stat-value" id="st-uptime">—</div></div>
        <div class="stat-card"><div class="stat-label">Versi</div><div class="stat-value" id="st-version">—</div></div>
        <div class="stat-card"><div class="stat-label">Memori</div><div class="stat-value" id="st-memory">—</div></div>
        <div class="stat-card"><div class="stat-label">File Workspace</div><div class="stat-value" id="st-files">—</div></div>
        <div class="stat-card"><div class="stat-label">Sesi Saya</div><div class="stat-value" id="st-sessions">—</div></div>
        <div class="stat-card"><div class="stat-label">Sesi Aktif</div><div class="stat-value" id="st-active">—</div></div>
        <div class="stat-card"><div class="stat-label">Model Aktif</div><div class="stat-value" id="st-model" style="font-size:13px;">—</div></div>
        <div class="stat-card"><div class="stat-label">Thinking</div><div class="stat-value" id="st-thinking">—</div></div>
        <div class="stat-card"><div class="stat-label">💵 Cost Sesi</div><div class="stat-value" id="st-cost">—</div></div>
        <div class="stat-card"><div class="stat-label">🧮 Token Total</div><div class="stat-value" id="st-tokens">—</div></div>
        <div class="stat-card"><div class="stat-label">📐 Context</div><div class="stat-value" id="st-context">—</div></div>
        <div class="stat-card"><div class="stat-label">🔧 Tool Calls</div><div class="stat-value" id="st-toolcalls">—</div></div>
      </div>
      <div class="field" style="margin-bottom:0;"><label>Sesi Aktif</label><div id="st-session-name" style="font-size:14px;color:var(--muted);">—</div></div>
      <div style="margin-top:14px;"><button class="btn" id="report-download">📄 Unduh Laporan (Markdown)</button></div>
      <div class="msg-err" id="status-err"></div>
    </div>

    <div class="set-panel" id="panel-prompts" style="display:none;">
      <h3>📝 Template Prompt</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:14px;">Simpan prompt reusable. Klik tombol <b>📝</b> di kolom chat untuk memakainya.</p>
      <div id="prompt-list"></div>
      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);">
        <h3 style="margin-bottom:12px;">Tambah Template</h3>
        <div class="field"><label>Nama</label><input type="text" id="pt-name" placeholder="misal: Review kode"></div>
        <div class="field"><label>Isi Prompt</label><textarea id="pt-text" rows="4" placeholder="Teks prompt yang akan dikirim ke Prime..."></textarea></div>
        <button class="btn primary" id="pt-save">Simpan Template</button>
        <div class="msg-ok" id="pt-ok"></div>
        <div class="msg-err" id="pt-err"></div>
      </div>
    </div>

    <div class="set-panel" id="panel-schedules" style="display:none;">
      <h3>⏰ Jadwal Agent</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:14px;">Jadwalkan Prime bekerja otomatis. Format cron: <code>menit jam hari tanggal bulan hari-minggu</code> — contoh <code>0 2 * * *</code> = tiap hari jam 2 pagi.</p>
      <div id="schedule-list"></div>
      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);">
        <h3 style="margin-bottom:12px;">Tambah Jadwal</h3>
        <div class="field"><label>Cron Schedule</label><input type="text" id="sch-cron" placeholder="0 2 * * *"></div>
        <div class="field"><label>Prompt / Tugas</label><textarea id="sch-prompt" rows="3" placeholder="misal: Cek kompetitor dan buat laporan ringkas, kirim hasilnya di chat."></textarea></div>
        <button class="btn primary" id="sch-save">➕ Tambah Jadwal</button>
        <div class="msg-ok" id="sch-ok"></div>
        <div class="msg-err" id="sch-err"></div>
      </div>
    </div>

    <div class="set-panel" id="panel-autonomous" style="display:none;">
      <h3>🤖 Mode Otonom</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:14px;">Kasih Prime tugas besar → dia kerjakan mandiri sampai selesai (dengan batas aman). Cocok untuk: riset kompetitor, laporan panjang, debugging berjam-jam.</p>
      <div class="field">
        <label>Goal / Tugas</label>
        <textarea id="auto-goal" rows="3" placeholder="Contoh: Riset 10 kompetitor utama di bidang X, buat laporan lengkap dengan analisa SWOT"></textarea>
      </div>
      <div class="field">
        <label>Batas Turn (maks siklus kerja)</label>
        <select id="auto-turns">
          <option value="4">4 (ringan, ~15 menit)</option>
          <option value="8" selected>8 (sedang, ~30-60 menit)</option>
          <option value="15">15 (berat, ~1-2 jam)</option>
        </select>
      </div>
      <button class="btn primary" id="auto-start">🚀 Mulai Mode Otonom</button>
      <button class="btn gold" id="auto-stop" style="margin-left:8px;display:none;">⏹ Stop</button>
      <div id="auto-status" style="margin-top:12px;padding:12px;background:var(--bg);border:1px solid var(--border);border-radius:10px;display:none;">
        <div id="auto-status-text">—</div>
      </div>
      <div class="msg-ok" id="auto-ok"></div>
      <div class="msg-err" id="auto-err"></div>
    </div>

    <div class="set-panel" id="panel-skills" style="display:none;">
      <h3>🧠 Skills Prime</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:14px;">Skill = kemampuan khusus yang bisa dipanggil kapan pun. Instal template, lalu bilang ke Prime: "Gunakan skill analisa saham untuk X".</p>
      <div id="skills-templates" style="margin-bottom:16px;"></div>
      <h3 style="margin-bottom:8px;">Terpasang</h3>
      <div id="skills-installed" style="color:var(--muted);font-size:13px;"></div>
      <div class="msg-ok" id="skill-ok"></div>
      <div class="msg-err" id="skill-err"></div>
    </div>
  </div>
</div>
<div id="login-overlay">
  <div class="login-card">
    <img class="logo-badge" src="/icon-192.png" alt="Prime Agent Hub">
    <h2>Selamat Datang</h2>
    <p>Masuk dengan akunmu untuk lanjut ke Prime Agent Hub.</p>
    <div class="field"><input type="text" id="login-username" placeholder="Username" autocomplete="username"></div>
    <div class="field"><input type="password" id="login-password" placeholder="Password" autocomplete="current-password"></div>
    <div class="field" id="mfa-login-field" style="display:none;"><input type="text" id="mfa-login-code" placeholder="Kode 6 digit (MFA)" inputmode="numeric" autocomplete="one-time-code" maxlength="6"></div>
    <button id="login-btn">Masuk</button>
    <button id="mfa-verify-btn" style="display:none;">Verifikasi Kode</button>
    <div id="login-error"></div>
  </div>
</div>

<div class="toast" id="toast"></div>
<input type="file" id="attach-file" accept="image/png,image/jpeg,image/webp" style="display:none;">

<script src="/app.js"></script>
</body>
</html>

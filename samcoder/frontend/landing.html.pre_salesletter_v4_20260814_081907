.final-cta p { color:var(--muted); margin-bottom:30px; }

/* FOOTER */
.footer { border-top:1px solid var(--border); padding:30px 0; text-align:center; color:var(--muted); font-size:13px; }
.footer a { color:var(--muted); }
</style>

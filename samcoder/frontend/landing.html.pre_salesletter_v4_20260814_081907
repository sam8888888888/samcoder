.quote .who .nm { font-weight:700; font-size:13px; }
.quote .who .rl { color:var(--muted); font-size:12px; }

/* FAQ */
.faq { max-width:720px; margin:0 auto; }
.faq details { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:16px 20px; margin-bottom:10px; }
.faq summary { font-weight:700; cursor:pointer; }
.faq details p { color:var(--muted); font-size:14px; margin-top:10px; }

/* CTA FINAL */
